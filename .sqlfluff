[sqlfluff]
dialect = postgres
templater = raw
max_line_length = 120

# Игнорируем излишне строгие правила (например, требование везде писать явные AS)
exclude_rules = layout.long_lines,ambiguous.column_count

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
# SELECT, FROM, WHERE, CREATE TABLE — только заглавными
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
# Имена таблиц и колонок (client_id, loans) — строчными
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
# Встроенные функции (NOW(), COUNT()) — заглавными
capitalisation_policy = upper